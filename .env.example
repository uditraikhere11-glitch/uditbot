# =====================================================================
# AUDIT BOT / DHAN ALGO - OPERATOR CONFIGURATION TEMPLATE (V14.0.1)
# Copy to .env and populate operator-specific values (chmod 0600 .env).
# Do NOT commit real credentials, tokens, or session strings to Git.
# =====================================================================

OPERATOR_NAME=Operator
BOT_INSTANCE_NAME=uditbot
TRADING_MODE=TEST
EQUITY_ACTIVE=true
FNO_ACTIVE=true

# Telegram Configuration
TG_API_ID=0
TG_API_HASH=
TG_BOT_TOKEN=
MONITORED_CHANNEL_IDS=
LOG_GROUP_ID=
DHAN_RESPONSE_GROUP_NAME=
TEST_GROUP_ID=
IGNORE_TELEGRAM_BACKLOG_ON_RESTART=true

# DhanHQ v2 Exchange Credentials
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
DHAN_ACCESS_TOKEN=
DHAN_TOKEN_FILE=~/.dhan_token

# Capital & Position Sizing (Equity)
EQUITY_PRODUCT_TYPE=CNC
EQUITY_SIZING_MODE=BUDGET
EQUITY_BUDGET_INR=25000.0
EQUITY_FIXED_QTY=10
EQUITY_PRICE_MARKUP_PCT=0.5
EQUITY_CMP_EXECUTION_POLICY=STRICT_TIMESTAMP

# Equity Protection Route & After-Market Orders (AMO)
# - FOREVER_OCO (default for regular market hours & AMO): places regular entry order via /v2/orders
#   and post-fill OCO via /v2/forever/orders (note: same-day CNC SELL Forever OCO requires DDPI/POA or settled holdings).
# - SUPER_ORDER (optional explicit override): places atomic entry + SL/Target via Dhan /v2/super/orders.
#   IMPORTANT: DhanHQ v2 requires Static IP whitelisting on the VM for LIVE Super Order placement.
# - Closed-session NSE CNC AMO (when EQUITY_AMO_ENABLED=true) always uses /v2/orders (afterMarketOrder=true,
#   amoTime=OPEN) and post-fill FOREVER_OCO, never Super Order.
EQUITY_PROTECTION_ROUTE=FOREVER_OCO
EQUITY_AMO_ENABLED=false
EQUITY_AMO_MAX_REFERENCE_AGE_SEC=259200.0

# Capital & Position Sizing (Stock Options / F&O)
FNO_SIZING_MODE=BUDGET
FNO_CAPITAL_PER_TRADE=20000.0
FNO_FIXED_LOTS=1
FNO_MAX_LOTS=3

# Risk Management Controls
MAX_ORDER_AMOUNT_INR=50000.0
MIN_TRADE_FUNDS_INR=0.0
TEST_MODE_PAPER_FUNDS_INR=100000.0
MAX_DAILY_LOSS_INR=15000.0
MAX_DAILY_TRADES=2
MAX_TOTAL_EXPOSURE_INR=150000.0
MAX_OPEN_POSITIONS=5
MAX_DRAWDOWN_PCT=5.0
INSUFFICIENT_FUNDS_POLICY=HARD_REJECT
MODE_SWITCH_POSITION_POLICY=REMAIN_UNTOUCHED

# Protection & Timing
SL_PCT=3.0
TARGET_PCT=3.0
SL_LIMIT_BUFFER_PCT=1.0
MAX_MESSAGE_AGE_SEC=60.0
DEDUP_WINDOW_SEC=20.0
MAX_QUOTE_AGE_SEC=2.0
PARTIAL_FILL_RETRY_TIMEOUT_SEC=2.0
ORDER_TIMEOUT_SEC=60.0
SCRIP_MASTER_MAX_AGE_SEC=86400
ALLOW_NEXT_MONTH_EXPIRY_FALLBACK=true
