DEDUP_WINDOW_SEC=20.0
MAX_QUOTE_AGE_SEC=2.0
PARTIAL_FILL_RETRY_TIMEOUT_SEC=2.0
ORDER_TIMEOUT_SEC=60.0
SCRIP_MASTER_MAX_AGE_SEC=86400
ALLOW_NEXT_MONTH_EXPIRY_FALLBACK=true
