OPERATOR_NAME=Operator
BOT_INSTANCE_NAME=uditbot
TRADING_MODE=TEST
EQUITY_ACTIVE=true
FNO_ACTIVE=true

# Telegram Configuration
TG_API_ID=0
TG_API_HASH=
TG_BOT_TOKEN=
MONITORED_CHANNEL_IDS=
LOG_GROUP_ID=
TEST_GROUP_ID=
