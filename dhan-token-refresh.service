# Historical VM reference unit (udit_raikhere11).
# Do NOT copy manually to /etc/systemd/system on a new VM; instead run:
#   bash deploy/install_vm_services.sh --install
# which dynamically substitutes the active Linux username ($BOT_USER) and checkout path ($REPO_DIR).
[Unit]
Description=AuditBot V13 Daily Dhan TOTP Access Token Refresh & Health Probe
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=oneshot
User=udit_raikhere11
Group=udit_raikhere11
WorkingDirectory=/home/udit_raikhere11/uditbot
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/udit_raikhere11/uditbot/bot daily_health_check
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=auditbot-token-refresh
