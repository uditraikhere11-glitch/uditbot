#!/usr/bin/env bash
# =====================================================================
# PLATINUM / UDITBOT UNIFIED OPERATOR CLI ('bot')
# V12-22 Fix: Resolves symlinks (e.g. /usr/local/bin/bot) and changes
# into the application root directory before executing commands.
# =====================================================================
set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$LINK_DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
cd "$DIR"

PYTHON="${DIR}/venv/bin/python3"
if [ ! -f "$PYTHON" ]; then
    PYTHON="python3"
fi

export PYTHONPATH="${DIR}:${PYTHONPATH:-}"

case "${1:-}" in
    status)
        "$PYTHON" -m src.cli status
        ;;
    dashboard|dash)
        "$PYTHON" -m src.cli dashboard
        ;;
    check-dhan|test-dhan|dhan)
        "$PYTHON" -m src.cli check-dhan
        ;;
    login|refresh-token|token|totp)
        "$PYTHON" -m src.cli login
        ;;
    daily_health_check|daily-health-check|health-check)
        "$PYTHON" -m src.cli daily_health_check
        ;;
    mode)
        "$PYTHON" -m src.cli mode
        ;;
    setup)
        "$PYTHON" -m src.setup_wizard
        ;;
    web)
        shift || true
        "$PYTHON" -m src.cli web "$@"
        ;;
    journal|logs)
        shift || true
        "$PYTHON" -m src.cli journal "$@"
        ;;
    test-signal|test_signal)
        shift || true
        "$PYTHON" -m src.cli test-signal "$@"
        ;;
    emergency-stop|stop-trading)
        shift || true
        "$PYTHON" -m src.cli emergency-stop "$@"
        ;;
    resume|start-trading)
        shift || true
        "$PYTHON" -m src.cli resume "$@"
        ;;
    start)
        sudo systemctl start trading_bot.service
        echo "trading_bot service started."
        ;;
    stop)
        sudo systemctl stop trading_bot.service
        echo "trading_bot service stopped."
        ;;
    restart)
        sudo systemctl restart trading_bot.service
        echo "trading_bot service restarted."
        ;;
    service-logs)
        sudo journalctl -u trading_bot.service -f
        ;;
    live)
        echo "⚠️  SWITCHING TRADING_MODE TO LIVE"
        read -p "Are you sure you want to enable LIVE broker order placement? (yes/no): " ans
        if [ "$ans" = "yes" ]; then
            if [ -f "${DIR}/.env" ]; then
                sed -i 's/^TRADING_MODE=.*/TRADING_MODE=LIVE/' "${DIR}/.env"
                echo "TRADING_MODE set to LIVE in .env."
                if systemctl is-active --quiet trading_bot.service; then
                    sudo systemctl restart trading_bot.service
                    echo "Service restarted in LIVE mode."
                fi
            else
                echo "Error: .env not found. Run 'bot setup' first."
            fi
        else
            echo "Cancelled. Still in current mode."
        fi
        ;;
    test)
        if [ -f "${DIR}/.env" ]; then
            sed -i 's/^TRADING_MODE=.*/TRADING_MODE=TEST/' "${DIR}/.env"
            echo "TRADING_MODE set to TEST in .env."
            if systemctl is-active --quiet trading_bot.service; then
                sudo systemctl restart trading_bot.service
                echo "Service restarted in TEST mode."
            fi
        fi
        ;;
    help|--help|-h|*)
        echo "======================================================="
        echo "      PLATINUM / UDITBOT OPERATOR CONTROL CLI         "
        echo "======================================================="
        echo "Usage: bot <command>"
        echo ""
        echo "Operational Commands:"
        echo "  bot status              Check running status, mode, and parameters"
        echo "  bot dashboard           Live read-only SSH terminal dashboard"
        echo "  bot check-dhan          Diagnose Dhan API connection, funds, LTP, and execution readiness"
        echo "  bot login               Generate fresh 24h Dhan access token using TOTP"
        echo "  bot daily_health_check  Run scheduled 08:00 IST token refresh & health probe"
        echo "  bot setup               Run interactive terminal setup wizard"
        echo "  bot web                 Launch localhost setup web interface (127.0.0.1:8080)"
        echo "  bot journal [n]         View last n signal evaluation records"
        echo "  bot live                Switch master mode to LIVE (requires confirmation)"
        echo "  bot test                Switch master mode to TEST"
        echo "  bot emergency-stop      Halt all new trade entries immediately"
        echo "  bot resume              Resume normal trading operations"
        echo "  bot start               Start systemd service"
        echo "  bot stop                Stop systemd service"
        echo "  bot restart             Restart systemd service"
        echo "  bot service-logs        Watch systemd service logs live"
        echo "======================================================="
        ;;
esac
